{
  "task_config": {
    "input_variables": [
      "2m_temperature",
      "mean_sea_level_pressure",
      "10m_v_component_of_wind",
      "10m_u_component_of_wind",
      "sea_surface_temperature",
      "temperature",
      "geopotential",
      "u_component_of_wind",
      "v_component_of_wind",
      "vertical_velocity",
      "specific_humidity",
      "year_progress_sin",
      "year_progress_cos",
      "day_progress_sin",
      "day_progress_cos",
      "geopotential_at_surface",
      "land_sea_mask"
    ],
    "target_surface_variables": [
      "2m_temperature",
      "mean_sea_level_pressure",
      "10m_v_component_of_wind",
      "10m_u_component_of_wind",
      "total_precipitation_12hr",
      "sea_surface_temperature"
    ],
    "target_atmospheric_variables": [
      "temperature",
      "geopotential",
      "u_component_of_wind",
      "v_component_of_wind",
      "vertical_velocity",
      "specific_humidity"
    ],
    "forcing_variables": [
      "year_progress_sin",
      "year_progress_cos",
      "day_progress_sin",
      "day_progress_cos"
    ],
    "static_variables": [
      "geopotential_at_surface",
      "land_sea_mask"
    ],
    "pressure_levels": [50, 100, 150, 200, 250, 300, 400, 500, 600, 700, 850, 925, 1000],
    "input_duration": "24h",
    "region": null
  },

  "sampler_config": {
    "max_noise_level": 80.0,
    "min_noise_level": 0.03,
    "num_noise_levels": 20,
    "rho": 7.0,
    "stochastic_churn_rate": 2.5,
    "churn_min_noise_level": 0.75,
    "churn_max_noise_level": 80.0,
    "noise_level_inflation_factor": 1.05
  },

  "noise_config": {
    "training_noise_level_rho": 7.0,
    "training_max_noise_level": 88.0,
    "training_min_noise_level": 0.02
  },

  "noise_encoder_config": {
    "apply_log_first": true,
    "base_period": 16.0,
    "num_frequencies": 32,
    "output_sizes": [32, 16]
  },

  "denoiser_architecture_config": {
    "sparse_transformer_config": {
      "attention_k_hop": 32,
      "d_model": 512,
      "num_layers": 16,
      "num_heads": 4,
      "attention_type": "splash_mha",
      "mask_type": "lazy",
      "block_q": 1024,
      "block_kv": 512,
      "block_kv_compute": 256,
      "block_q_dkv": 512,
      "block_kv_dkv": 1024,
      "block_kv_dkv_compute": 1024,
      "ffw_winit_final_mult": 0.0,
      "attn_winit_final_mult": 0.0,
      "ffw_hidden": 2048,
      "name": null
    },
    "mesh_size": 6,
    "latent_size": 512,
    "hidden_layers": 1,
    "radius_query_fraction_edge_length": 0.6,
    "norm_conditioning_features": ["noise_level_encodings"],
    "grid2mesh_aggregate_normalization": null
  },

  "training_config": {
    "loss_function": "weighted_mse_per_level",
    "per_variable_weights": {
      "2m_temperature": 1.0,
      "10m_u_component_of_wind": 0.1,
      "10m_v_component_of_wind": 0.1,
      "mean_sea_level_pressure": 0.1,
      "sea_surface_temperature": 0.01,
      "total_precipitation_12hr": 0.1
    },
    "loss_area_weighting": true,
    "loss_noise_level_weighting": true,
    "optimizer": "adamw",
    "weight_decay": 0.1,
    "lr_decay_schedule": "cosine",
    "gradient_clip_norm": 1.0,
    "batch_size": 32,

    "stage_1": {
      "description": "Pre-training at 1-degree resolution",
      "mesh_size": 5,
      "learning_rate": 1e-3,
      "warmup_steps": 1000,
      "num_steps": 2000000
    },
    "stage_2": {
      "description": "Fine-tuning at 0.25-degree resolution. Divide grid2mesh encoder message vectors by 16 before starting to avoid signal shock from the denser grid.",
      "mesh_size": 6,
      "learning_rate": 1e-4,
      "warmup_steps": 5000,
      "num_steps": 64000
    },

    "num_steps": 100000,
    "learning_rate": 1e-4,
    "num_epochs": 10,
    "target_lead_times": "12h",
    "training_time_start": null,
    "training_time_end": null
  }
}
